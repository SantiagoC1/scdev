# Copiar a .env (ignorado por git) y completar. En producción, las mismas variables van en
# Netlify → Site configuration → Environment variables. Nunca commitear claves reales.

# --- Formulario y precios en vivo (Google Apps Script publicado como web app) ---
# Cliente (Vite, queda embebida en el build; es una URL pública, no un secreto)
VITE_APPS_SCRIPT_URL=
# Servidor (la función /api/punto lee los precios del Sheet). Mismo valor que la línea de arriba.
# Si falta, la función usa VITE_APPS_SCRIPT_URL.
APPS_SCRIPT_URL=

# --- Punto: claves de los proveedores de IA (solo servidor, nunca con prefijo VITE_) ---
# Orden de la cadena: Groq -> Gemini -> Cloudflare. Un proveedor sin clave o sin modelo se saltea.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Punto: modelos (ver docs/pendientes.md para los ids verificados y la fecha) ---
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Punto: reasoning_effort por proveedor (opcional; si está vacío no se envía) ---
GROQ_REASONING_EFFORT=low
GEMINI_REASONING_EFFORT=minimal
# CLOUDFLARE_REASONING_EFFORT=

# --- Punto: límite diario ---
# Sal para el hash de la IP (cualquier texto largo y secreto). Cambiarla reinicia los contadores.
PUNTO_SALT=
# Mensajes por IP por día (por defecto 30). Bajarlo solo para probar.
# PUNTO_LIMITE_DIA=30
# Tope global de mensajes por día, para todos los visitantes juntos (por defecto 600). Protege el plan gratuito de la IA.
PUNTO_TOPE_DIARIO=600
